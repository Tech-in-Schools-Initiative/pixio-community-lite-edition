# ── Pixio Studio environment ────────────────────────────────────────────────
# The app is bring-your-own-key: users paste a Prodia key in the UI (stored only
# in their browser). These server vars are optional fallbacks / AI features.

# Optional server-side Prodia key fallback (used only if a request has no key).
PRODIA_KEY=

# Optional: enables AI prompt remix (/api/assist) and image→prompt (/api/vision).
# Without it, both gracefully fall back to strong local heuristics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_VISION_MODEL=gpt-5.5
